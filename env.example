# ============ SERVER (.env in the main jarvis-vscode folder) ============

# Required — FREE, no credit card needed. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional paid fallbacks used only if Gemini fails. Leave blank to skip.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# REQUIRED now that this is public — protects your dashboard with a password.
# Pick your own password and a long random secret (any long random string works).
DASHBOARD_PASSWORD=choose-a-real-password
SESSION_SECRET=change-this-to-a-long-random-string

# REQUIRED for laptop/phone tool access. Any long random string — this is
# separate from your dashboard password and never touches the browser.
AGENT_SECRET=change-this-to-a-different-long-random-string


# ============ LAPTOP AGENT (separate .env inside agent use, same folder is fine) ============
# JARVIS_SERVER_URL=https://your-app.onrender.com
# AGENT_SECRET=(same value as above)
# JARVIS_SAFE_FOLDER=JarvisFiles


# ============ PHONE AGENT (separate .env, inside Termux) ============
# JARVIS_SERVER_URL=https://your-app.onrender.com
# AGENT_SECRET=(same value as above)
