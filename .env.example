# Copy this file to ".env" and paste your real keys in below.

# Required — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional but recommended — used as automatic fallback if Claude fails.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
